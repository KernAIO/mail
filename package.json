{
  "name": "@kernhq/mail-service",
  "version": "0.1.0",
  "private": true,
  "description": "Kern mail service: hosts the mail module (outbound providers, templates, delivery queue, webhooks) and the IMAP inbox sync engine",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "biome check . && node scripts/check-ranges.mjs package.json",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kernhq/contracts": "^0.7.0",
    "@kernhq/kernel": "^0.9.1",
    "@kernhq/module-mail": "^0.5.0",
    "dotenv": "^17.4.0",
    "fastify": "^5.6.0",
    "imapflow": "^1.7.0",
    "zod": "^4.1.0",
    "drizzle-orm": "^0.45.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@kernhq/testing": "^0.1.12",
    "@kernhq/tsconfig": "^0.1.1",
    "@orpc/contract": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "overrides": {
      "@kernhq/kernel": "$@kernhq/kernel",
      "@kernhq/contracts": "$@kernhq/contracts"
    }
  }
}
