# Mail service. Kernel-level variables (DATABASE_URL, NATS_URL, KERN_SECRET, CORE_URL…) are inherited
# from the umbrella .env in development.
PORT=4200

# Fallback provider when a workspace has not configured its own
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Kern <no-reply@localhost>"
KERN_INSTANCE_NAME=Kern

# Shared secret for provider webhooks (append ?token=… to the URL you register)
MAIL_WEBHOOK_TOKEN=
